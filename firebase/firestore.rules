rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- USERS -----
    // user profiles — only accessible by that user
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ----- GAMES CATALOG (public read and listing) -----
    // List of available games, metadata — readable by anyone
    match /gamesCatalog/{gameId} {
      allow read: if true;
      // Optional: restrict writes to admins only and To prevent anonymous writes — writes disabled for now
      allow write: if false;
    }

    // ----- OWNED GAMES (user purchases/unlocked games) -----
    match /ownedGames/{docId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ----- SCORES (per-user game scores / records) -----
    match /scores/{docId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
  }
}
